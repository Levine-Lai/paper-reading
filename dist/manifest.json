{
  "manifest_version": 3,
  "name": "Paper Reading",
  "version": "0.1.0",
  "description": "Local PDF reader that highlights useful English vocabulary for learners.",
  "action": {
    "default_title": "Paper Reading",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["tabs"],
  "host_permissions": ["file:///*"],
  "content_scripts": [
    {
      "matches": ["file:///*"],
      "js": ["content-toggle.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["overlay.html", "reader.html", "assets/*"],
      "matches": ["file:///*"]
    }
  ]
}
